NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials
# Create a free project at https://supabase.com
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=study_materials

# Google Gemini API
# Get an API key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Upload Configuration
MAX_UPLOAD_MB=50

# Study Platform Defaults
INITIAL_FREE_COINS=500
DAILY_BONUS_COINS=50
NOTE_GENERATION_COIN_COST=20
QUIZ_GENERATION_COIN_COST=15
TUTOR_MESSAGE_COIN_COST=5
QUESTION_ANALYSIS_COIN_COST=25
REVISION_SHEET_COIN_COST=15
AUDIO_EXPLANATION_COIN_COST=30
