{
  "info": {
    "name": "Brain Nest AI Platform API",
    "description": "Postman Collection for Brain Nest Intelligence Platform Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000/api/v1"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Auth - Signup",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/signup",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"securePass123!\",\n  \"fullName\": \"Alex Rahman\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"student@example.com\",\n  \"password\": \"securePass123!\"\n}"
        }
      }
    },
    {
      "name": "Auth - Get Me",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
      }
    },
    {
      "name": "Wallet - Get Balance",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/wallet",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
      }
    },
    {
      "name": "Wallet - Claim Daily Bonus",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/wallet/daily-bonus",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
      }
    },
    {
      "name": "Documents - List All",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/documents",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
      }
    },
    {
      "name": "AI Notes - Generate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/notes/generate",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Physics\",\n  \"chapter\": \"Thermodynamics & Heat\",\n  \"difficulty\": \"intermediate\",\n  \"outputType\": \"detailed\",\n  \"language\": \"both\"\n}"
        }
      }
    },
    {
      "name": "AI Quiz - Generate",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/quizzes/generate",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Physics\",\n  \"chapter\": \"Thermodynamics & Heat\",\n  \"questionCount\": 5,\n  \"difficulty\": \"intermediate\"\n}"
        }
      }
    },
    {
      "name": "AI Tutor - Chat Message",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/tutor/message",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"Explain Carnot cycle efficiency simply in Bangla and English\",\n  \"subject\": \"Physics\"\n}"
        }
      }
    },
    {
      "name": "Past Papers - Multi-Year Analysis",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/question-papers/analyze",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Physics\",\n  \"chapter\": \"Thermodynamics & Heat\",\n  \"boardOrExam\": \"HSC Board\",\n  \"sampleQuestionsText\": \"2024: Carnot engine efficiency between 400K and 300K.\\n2023: Calculate work done in adiabatic expansion.\\n2022: State second law of thermodynamics and Clausius inequality.\"\n}"
        }
      }
    },
    {
      "name": "Revision - Generate Rapid Sheet",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/revision/generate",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{authToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"subject\": \"Physics\",\n  \"chapter\": \"Thermodynamics & Heat\"\n}"
        }
      }
    },
    {
      "name": "Graph - Prerequisite Knowledge Tree",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/graph?subject=Physics",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
      }
    },
    {
      "name": "Study Progress & Analytics",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/progress",
        "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }]
      }
    }
  ]
}
